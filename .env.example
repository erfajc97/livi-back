# ── Servidor ──
PORT=4101
NODE_ENV=development

# ── Base de datos (PostgreSQL) ──
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=livi
DB_SSL=false
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# ── Auth ──
JWT_SECRET=
JWT_EXPIRES_IN=1d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4101/api/auth/google/callback

# ── URLs / CORS (lista separada por comas) ──
FRONTEND_URL=http://localhost:4801
CORS_ORIGINS=http://localhost:3000

# ── Cloudinary (imágenes, videos y comprobantes de transferencia) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=livi

# ── Correo (Resend) ──
RESEND_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=LIVI
MAIL_LOGO_URL=

# ── PayPhone ──
PAYPHONE_API_URL=https://pay.payphonetodoesposible.com/api
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=
PAYPHONE_RESPONSE_URL=http://localhost:4801/orden/confirmacion
PAYPHONE_CANCELLATION_URL=http://localhost:4801/checkout?cancelled=true

# ── Admin ──
ADMIN_EMAIL=
ADMIN_WHATSAPP=
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# ── Walletfy (opcional) ──
WALLETFY_API_KEY=
